{
  "name": "aima",
  "version": "0.1.0",
  "description": "Personal home economy survival helper",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check --no-error-on-unmatched-pattern src scripts tests \"*.js\" \"*.json\"",
    "format": "prettier --write --no-error-on-unmatched-pattern src scripts tests \"*.js\" \"*.json\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs dist 8080",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9"
  }
}
